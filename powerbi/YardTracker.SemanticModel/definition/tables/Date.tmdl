/// Calendar in plant-local business days (rpt.DimDate).
table Date
	dataCategory: Time

	column DateKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: DateKey

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Quarter

	column MonthNumber
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: MonthNumber

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: MonthNumber

	column YearMonth
		dataType: string
		summarizeBy: none
		sourceColumn: YearMonth

	column IsoWeek
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: IsoWeek

	column DayOfWeekNumber
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: DayOfWeekNumber

	column DayName
		dataType: string
		summarizeBy: none
		sourceColumn: DayName
		sortByColumn: DayOfWeekNumber

	column IsWeekend
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: IsWeekend

	partition Date = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema = "rpt", Item = "DimDate"]}[Data]
				in
				    Data

