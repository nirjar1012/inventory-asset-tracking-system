<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="YardTracker"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=YardTracker;Integrated Security=true;Application Name=YardTracker.Service"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.serviceModel>
    <services>
      <service name="YardTracker.Service.YardTrackerService" behaviorConfiguration="YardTrackerBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8523/YardTracker/" />
          </baseAddresses>
        </host>

        <!-- Scanning stations (handhelds, RFID portals, kiosks) -->
        <endpoint address="Inventory" binding="netTcpBinding" bindingConfiguration="StationBinding"
                  contract="YardTracker.Contracts.IInventoryService" />

        <!-- Truck deliveries and GPS pings from driver handhelds -->
        <endpoint address="Logistics" binding="netTcpBinding" bindingConfiguration="StationBinding"
                  contract="YardTracker.Contracts.ILogisticsService" />

        <!-- Machine telemetry from the Modbus TCP edge gateway -->
        <endpoint address="Telemetry" binding="netTcpBinding" bindingConfiguration="StationBinding"
                  contract="YardTracker.Contracts.ITelemetryService" />

        <!-- WSDL/metadata for "Add Service Reference" or dotnet-svcutil. It lives on its own port:
             without port sharing, every endpoint on one TCP port must use identical listener
             settings, and mexTcpBinding cannot match the tuned StationBinding. -->
        <endpoint address="net.tcp://localhost:8524/YardTracker/mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
    </services>

    <bindings>
      <netTcpBinding>
        <!--
          Short timeouts suit a wireless handheld: fail fast, let the client queue the scan
          offline and retry with the same ClientScanId.

          Security: Transport + Windows credentials (signed and encrypted) works on a domain or a
          single machine. For workgroup handhelds use clientCredentialType="Certificate".
          The client setting in station.json / appsettings.json must match.
        -->
        <binding name="StationBinding"
                 openTimeout="00:00:05"
                 sendTimeout="00:00:15"
                 receiveTimeout="00:10:00"
                 maxReceivedMessageSize="4194304"
                 maxConnections="200"
                 listenBacklog="200">
          <readerQuotas maxArrayLength="1048576" maxStringContentLength="1048576" />
          <security mode="Transport">
            <transport clientCredentialType="Windows" protectionLevel="EncryptAndSign" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>

    <behaviors>
      <serviceBehaviors>
        <behavior name="YardTrackerBehavior">
          <serviceMetadata />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceThrottling maxConcurrentCalls="128" maxConcurrentSessions="400" maxConcurrentInstances="528" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
</configuration>
