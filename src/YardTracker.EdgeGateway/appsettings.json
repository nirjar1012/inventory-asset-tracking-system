{
  "Service": {
    "BaseAddress": "net.tcp://localhost:8523/YardTracker/",
    "Security": "Transport",
    "TimeoutSeconds": 10
  },
  "Modbus": {
    "Host": "127.0.0.1",
    "Port": 5020,
    "PollIntervalSeconds": 5,
    "TimeoutMilliseconds": 1500,
    "MaxBufferedReadings": 20000,
    "AutoResetFaultsAfterPolls": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
