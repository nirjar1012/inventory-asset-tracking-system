<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:YardTracker.Station">

    <!-- Palette: dark, high-contrast for glare-prone industrial displays, safety-yellow accent. -->
    <SolidColorBrush x:Key="Brush.Background" Color="#0E1217" />
    <SolidColorBrush x:Key="Brush.Header" Color="#090C10" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#161C23" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="#1E262F" />
    <SolidColorBrush x:Key="Brush.Border" Color="#2A3440" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E6EDF3" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#8B98A5" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#F5B301" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#111418" />

    <!-- Status colours, looked up by name through KeyToBrushConverter ("Status.<value>"). -->
    <SolidColorBrush x:Key="Status.Success" Color="#1F7A3A" />
    <SolidColorBrush x:Key="Status.Accepted" Color="#2EA043" />
    <SolidColorBrush x:Key="Status.Duplicate" Color="#2F6FD6" />
    <SolidColorBrush x:Key="Status.Queued" Color="#B7791F" />
    <SolidColorBrush x:Key="Status.Sending" Color="#6E7781" />
    <SolidColorBrush x:Key="Status.Error" Color="#B42318" />
    <SolidColorBrush x:Key="Status.Rejected" Color="#DA3633" />
    <SolidColorBrush x:Key="Status.Info" Color="#2B3A4A" />

    <SolidColorBrush x:Key="Status.InYard" Color="#2EA043" />
    <SolidColorBrush x:Key="Status.CheckedOut" Color="#6E7781" />
    <SolidColorBrush x:Key="Status.InTransit" Color="#2F81F7" />

    <SolidColorBrush x:Key="Status.Running" Color="#2EA043" />
    <SolidColorBrush x:Key="Status.Idle" Color="#4B5A6A" />
    <SolidColorBrush x:Key="Status.Fault" Color="#DA3633" />
    <SolidColorBrush x:Key="Status.Maintenance" Color="#D29922" />
    <SolidColorBrush x:Key="Status.Offline" Color="#30363D" />
    <SolidColorBrush x:Key="Status.NoData" Color="#30363D" />
    <SolidColorBrush x:Key="Status.Normal" Color="#E6EDF3" />
    <SolidColorBrush x:Key="Status.Warning" Color="#F5B301" />
    <SolidColorBrush x:Key="Status.Alarm" Color="#FF6B5E" />
    <SolidColorBrush x:Key="Status.OnDelivery" Color="#2F81F7" />

    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <local:NullToVisibilityConverter x:Key="NullToVisibility" />
    <local:UtcToLocalConverter x:Key="UtcToLocal" />
    <local:EnumEqualsConverter x:Key="EnumEquals" />
    <local:KeyToBrushConverter x:Key="KeyToBrush" />

    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Large touch-friendly mode selector for gloved hands. -->
    <Style x:Key="ModeTile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Tile" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="16,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Font.Icons}" FontSize="22"
                                       VerticalAlignment="Center" Foreground="{StaticResource Brush.Accent}" />
                            <ContentPresenter x:Name="Label" Margin="14,0,0,0" VerticalAlignment="Center"
                                              TextElement.FontSize="18" TextElement.FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource Brush.PanelRaised}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource Brush.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DrawingBrush x:Key="MapGridBrush" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FF10161D">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,40,40" />
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="#FF18212A" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
