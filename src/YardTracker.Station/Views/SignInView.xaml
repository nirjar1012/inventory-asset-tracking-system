<UserControl x:Class="YardTracker.Station.Views.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:YardTracker.Station.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShellViewModel}">
    <Grid>
        <Border Style="{StaticResource Panel}" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36">
            <StackPanel>
                <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource Font.Icons}" FontSize="40" Foreground="{StaticResource Brush.Accent}" />
                <TextBlock Text="Scan your badge" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBlock Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap"
                           Text="{Binding Settings.StationCode, StringFormat='Signing in to station {0}. Scan the badge barcode or type the badge number.'}" />

                <TextBox x:Name="BadgeBox" Margin="0,20,0,0" FontSize="26" Padding="12,8" FontFamily="{StaticResource Font.Mono}"
                         Text="{Binding BadgeInput, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SignInCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Content="Sign in" Command="{Binding SignInCommand}" Margin="0,12,0,0" Padding="16,10" FontSize="16" FontWeight="SemiBold"
                        HorizontalAlignment="Stretch" Background="{StaticResource Brush.Accent}" Foreground="{StaticResource Brush.OnAccent}" />

                <TextBlock Text="{Binding SignInError}" Foreground="{StaticResource Status.Alarm}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding SignInError, Converter={StaticResource NullToVisibility}}" />

                <TextBlock Text="{Binding DemoBadges}" Foreground="{StaticResource Brush.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,20,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
