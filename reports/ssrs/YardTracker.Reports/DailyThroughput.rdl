<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <Description>Scans per business day by movement type, with tonnage in and out. Built on the ETL summary table.</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="YardTracker">
      <DataSourceReference>YardTracker</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6f3c1a2e-8a1d-4b7e-9d0c-2b5e7f4a1c90</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Sites">
      <Query>
        <DataSourceName>YardTracker</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>rpt.usp_SiteList</CommandText>
      </Query>
      <Fields>
        <Field Name="SiteCode">
          <DataField>SiteCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SiteName">
          <DataField>SiteName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Throughput">
      <Query>
        <DataSourceName>YardTracker</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SiteCode">
            <Value>=Parameters!SiteCode.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>rpt.usp_DailyThroughput</CommandText>
      </Query>
      <Fields>
        <Field Name="BusinessDate">
          <DataField>BusinessDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DayName">
          <DataField>DayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IsWeekend">
          <DataField>IsWeekend</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="Receipts">
          <DataField>Receipts</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CheckIns">
          <DataField>CheckIns</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CheckOuts">
          <DataField>CheckOuts</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Moves">
          <DataField>Moves</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TruckLoads">
          <DataField>TruckLoads</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TruckDeliveries">
          <DataField>TruckDeliveries</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalScans">
          <DataField>TotalScans</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="InboundTons">
          <DataField>InboundTons</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OutboundTons">
          <DataField>OutboundTons</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
